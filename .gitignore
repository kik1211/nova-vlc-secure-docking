# Internal Workspace & Development Artifacts (Private - do NOT commit)
internal/
scratch/
tmp/
*.tmp
*.log

# Arduino / ESP32 Build Artifacts
build/
.arduino15/
*.elf
*.bin
*.hex
*.map

# Arduino IDE temporary files
*.pde.bak
*.ino.bak

# ESP-IDF build directory
sdkconfig
sdkconfig.old

# VSCode / IDE / Editors
.vscode/
.idea/
*.code-workspace
*.swp
*~

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# Secrets and credentials (NEVER commit these)
secrets.h
credentials.h
*.env
*.env.local


# Validation raw logs (may contain sensitive data)
validation/logs/*.bin

# Large binary assets (track with Git LFS if needed)
assets/*.mp4
hardware/datasheets/*.pdf

# Python virtual environments & bytecode
venv/
__pycache__/
*.pyc

# Node modules (if any web tools used)
node_modules/

# Compilation output
*.o
*.a
*.d
